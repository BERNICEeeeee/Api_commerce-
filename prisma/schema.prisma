datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Utilisateurs
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      String    @default("client") // "client", "vendeur", "admin"
  banned    Boolean   @default(false)
  products  Product[] @relation("VendeurProducts")
  orders    Order[]   @relation("ClientOrders")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 2. Produits
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int         @default(0)
  imageUrl    String?
  vendeurId   Int
  vendeur     User        @relation("VendeurProducts", fields: [vendeurId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 3. Commandes
model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation("ClientOrders", fields: [userId], references: [id])
  total     Float
  status    String      @default("pending")
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// 4. Lignes de commande
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}