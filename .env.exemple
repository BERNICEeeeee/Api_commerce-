PORT=8000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=e-commerce
JWT_AUDIENCE=e-commerce-api
DATABASE_URL=postgresql://api_app:replace-with-app-password@localhost:5432/mon_projet_db?schema=public
DATABASE_MIGRATION_URL=postgresql://api_migrator:replace-with-migration-password@localhost:5432/mon_projet_db?schema=public
APP_DB_USER=api_app
APP_DB_PASSWORD=replace-with-app-password
MIGRATION_DB_USER=api_migrator
MIGRATION_DB_PASSWORD=replace-with-migration-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-local-admin-password
UPLOAD_DIR=uploads
